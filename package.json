{
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-views",
    "clean": "shx rm -rf dist",
    "copy-views": "shx cp -r src/views/ dist && shx cp -r src/public/ dist",
    "start": "node dist/webapp.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-openid-connect": "^3.4.0",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "shx": "^0.4.0",
    "typescript": "^7.0.2"
  }
}
